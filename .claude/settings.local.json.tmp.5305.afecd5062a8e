{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:developers.home-assistant.io)",
      "WebFetch(domain:github.com)",
      "Bash(git init *)",
      "Bash(mkdir -p src dist)",
      "Bash(npm --version)",
      "Bash(git add *)",
      "Bash(git commit -q -m 'chore: project scaffolding \\(package.json, vite, license, readme stub\\) *)"
    ]
  }
}
